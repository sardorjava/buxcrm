  }else{
    var grp=msgs.filter(function(m){return m.type==='grp';});
    grp.forEach(function(m){if(!m.read.includes(U.id))m.read.push(U.id);});sm();updEMB();
    h+=`<div class="card"><p style="color:var(--mu);font-size:13px;margin-bottom:14px;">&#x1F310; Barcha xodimlar ko&#x27;radigan umumiy muhokama</p><div class="cwrap" id="ew2">${grp.length?grp.map(function(m){var snd=m.from==='manager'?null:gE(m.from);return msgBubble(m,m.from===U.id,m.from==='manager'?'Bosh Buxgalter':snd?snd.name:'?',snd);}).join(''):'<p class="echat">Hali xabar yo&#x27;q</p>'}</div><div class="cinp">${chatInputHTML('egi','btn-egrp',null)}</div></div>`;
  }
  setHTML('e-ms',h);
  g('e-ms').querySelectorAll('.mtab').forEach(function(btn){btn.onclick=function(){eMT=btn.dataset.et;if(eMT==='grp')msgTaskRef=null;rEMsgs();};});
  var ei=g('epi');if(ei)ei.onkeydown=function(e){if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();eSnd();}};
  var eb=g('btn-esnd');if(eb)eb.onclick=eSnd;
  var egi=g('egi');if(egi)egi.onkeydown=function(e){if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();eGrp();}};
  var egb=g('btn-egrp');if(egb)egb.onclick=eGrp;
  var ctr=g('btn-clear-task-ref');if(ctr)ctr.onclick=function(){msgTaskRef=null;rEMsgs();};
  scrl('ew1');scrl('ew2');
}
function eSnd(){var i=g('epi');if(!i||!U)return;var c=i.value.trim();if(!c)return;msgs.push({id:uid(),from:U.id,fromName:U.name,to:'manager',content:c,createdAt:new Date().toISOString(),type:'priv',read:[U.id],taskRef:msgTaskRef||null});sm();msgTaskRef=null;rEMsgs();}
function eGrp(){var i=g('egi');if(!i||!U)return;var c=i.value.trim();if(!c)return;msgs.push({id:uid(),from:U.id,fromName:U.name,to:'all',content:c,createdAt:new Date().toISOString(),type:'grp',read:[U.id],taskRef:null});sm();rEMsgs();}

