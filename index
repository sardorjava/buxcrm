${t.status==='done'?`<span style="color:var(--ac);font-size:13px;">&#x2713; Bajarildi</span>`:''}
</div></div></div>`;
    });
    h+='</div>';
  });
  setHTML('e-ta',h);
  g('e-ta').querySelectorAll('[data-start]').forEach(function(btn){btn.onclick=function(){var t=tasks.find(function(t){return t.id===btn.dataset.start;});if(t)t.status='in_progress';sv();rETasks();};});
  g('e-ta').querySelectorAll('[data-done]').forEach(function(btn){btn.onclick=function(){doneId=btn.dataset.done;doneFile=null;g('dnt').value='';g('dfl').textContent='Fayl tanlash (max 5MB)';g('dfd').classList.remove('hf');show('dmod','flex');};});
  g('e-ta').querySelectorAll('[data-task-msg]').forEach(function(btn){
    btn.onclick=function(){
      msgTaskRef={id:btn.dataset.taskMsg,title:btn.dataset.taskTitle};
      eMT='priv';
      g('et').querySelectorAll('.tab').forEach(function(b){b.classList.remove('active');});
      g('et').querySelectorAll('.tab[data-tab="ms"]')[0].classList.add('active');
      ['ta','re','ms'].forEach(function(x){g('e-'+x).style.display=x==='ms'?'block':'none';});
      rEMsgs();
    };
  });
}
function closeDM(){hide('dmod');doneId=null;doneFile=null;}
function confirmD(){
  if(!doneId)return;
  var nt=g('dnt').value.trim();
  var t=tasks.find(function(t){return t.id===doneId;});
  if(t){t.status='done';t.doneNote=nt;t.doneAttachment=doneFile||null;}
  sv();closeDM();rETasks();
}

// ===== EMPLOYEE REPORT =====
function rERep(){
  if(!U)return;
  var t=tday(),tr=reps.find(function(r){return r.employeeId===U.id&&r.date===t;});
  var h=`<p style="color:var(--mu);font-size:12px;margin-bottom:20px;">${new Date().toLocaleDateString('uz-UZ',{weekday:'long',year:'numeric',month:'long',day:'numeric'})}</p>`;
  if(repOk)h+=`<div class="smsg">&#x2705; Hisobot muvaffaqiyatli yuborildi!</div>`;
  if(tr)h+=`<div class="trep"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;"><span style="color:var(--ac);font-weight:500;font-size:13px;">&#x2705; Bugungi hisobot yuborilgan</span><span style="color:var(--mu);font-size:11px;">${ft(tr.submittedAt)}</span></div><p style="font-size:13px;line-height:1.7;white-space:pre-wrap;color:#bbb;">${esc(tr.content)}</p><p style="color:var(--mu);font-size:11px;margin-top:8px;">Qayta yuborish eski hisobotni almashtiradi</p></div>`;
  h+=`<div class="fg"><label class="fl">BUGUNGI ISH HISOBOTI</label><textarea id="rtxt" style="min-height:130px;" placeholder="Bugun nima ishlar qildingiz?"></textarea></div>`;
  h+=`<button class="bp" id="btn-subrep" style="width:100%;padding:13px;font-size:15px;">&#x1F4E4; Hisobotni yuborish</button>`;
  setHTML('e-re',h);
  var btn=g('btn-subrep');if(btn)btn.onclick=subRep;
}
function subRep(){
  var c=g('rtxt')&&g('rtxt').value.trim();if(!c)return;
  var r={id:uid(),employeeId:U.id,employeeName:U.name,date:tday(),content:c,submittedAt:new Date().toISOString()};
  reps=reps.filter(function(x){return!(x.employeeId===r.employeeId&&x.date===r.date);});
  reps.push(r);sv();repOk=true;rERep();setTimeout(function(){repOk=false;rERep();},4000);
}

// ===== MESSAGING =====
function msgBubble(m,isMine,senderName,senderEmp){
  var taskTag='';
  if(m.taskRef)taskTag=`<span class="msg-task-tag">&#x1F4CC; Vazifa: ${esc(m.taskRef.title)}</span>`;
  return `<div class="cmsg${isMine?' mine':''}">${!isMine?avH(senderEmp,28):''}<div>${!isMine&&senderName?`<div class="cnm">${esc(senderName)}</div>`:''}<div class="cbbl ${isMine?'mn':'oth'}">${taskTag}${esc(m.content)}</div><span class="ctim">${isMine?'Siz':esc(senderName||'?')} &#183; ${ft(m.createdAt)}</span></div></div>`;
}

function chatInputHTML(textareaId,sendBtnId,taskRef){
  var tag=taskRef?`<div class="task-ref" id="task-ref-bar">&#x1F4CC; ${esc(taskRef.title)} <button style="background:none;border:none;color:var(--mu);cursor:pointer;padding:0 0 0 6px;font-size:11px;" id="btn-clear-task-ref">&#x2715;</button></div>`:'';
  return `${tag}<div class="cinp-row"><textarea id="${textareaId}" placeholder="Xabar yozing..."></textarea><button class="bp" id="${sendBtnId}" style="padding:10px 16px;white-space:nowrap;">&#x27A4;</button></div>`;
}

function rMMsgs(){
  updMMB();
  var pu=msgs.filter(function(m){return m.type==='priv'&&!m.read.includes('manager');}).length;
  var gu=msgs.filter(function(m){return m.type==='grp'&&!m.read.includes('manager');}).length;
  var h=`<div class="mtabs"><button class="mtab${mMT==='priv'?' active':''}" data-mt="priv">&#x1F512; Shaxsiy${pu>0?'<span class="undot"></span>':''}</button><button class="mtab${mMT==='grp'?' active':''}" data-mt="grp">&#x1F310; Umumiy guruh${gu>0?'<span class="undot"></span>':''}</button></div>`;
  if(mMT==='priv'){
    h+=`<div class="plist">`;
    EMP.forEach(function(e){
      var em=msgs.filter(function(m){return m.type==='priv'&&(m.from===e.id||m.to===e.id);});
      var last=em.length?em[em.length-1]:null;
      var un=em.filter(function(m){return m.from===e.id&&!m.read.includes('manager');}).length;
      h+=`<div class="pi${acEmp===e.id?' acp':''}" data-emp="${e.id}">${avH(e,36)}<div style="flex:1;min-width:0;"><div style="display:flex;justify-content:space-between;align-items:center;"><span style="font-weight:500;font-size:14px;">${esc(e.name)}</span>${un>0?`<span class="tbdg">${un}</span>`:''}</div>${last?`<p style="color:var(--mu);font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${last.taskRef?'[Vazifa] ':''} ${esc(last.content)}</p>`:`<p style="color:var(--mu);font-size:12px;">Xabar yo&#x27;q</p>`}</div></div>`;
    });
    h+='</div>';
    if(acEmp){
      var e=gE(acEmp);
      var ch=msgs.filter(function(m){return m.type==='priv'&&(m.from===acEmp||m.to===acEmp);});
      ch.forEach(function(m){if(m.from===acEmp&&!m.read.includes('manager'))m.read.push('manager');});
      sm();updMMB();
      h+=`<div class="card" style="margin-top:12px;"><div style="font-weight:500;font-size:14px;margin-bottom:12px;display:flex;align-items:center;gap:8px;">${avH(e,24)}${esc(e?e.name:'?')} bilan suhbat</div><div class="cwrap" id="cw1">${ch.length?ch.map(function(m){return msgBubble(m,m.from==='manager',e?e.name:'?',e);}).join(''):'<p class="echat">Hali xabar yo&#x27;q</p>'}</div><div class="cinp">${chatInputHTML('mci','btn-msnd',msgTaskRef)}</div></div>`;
    }
  }else{
    var grp=msgs.filter(function(m){return m.type==='grp';});
    grp.forEach(function(m){if(!m.read.includes('manager'))m.read.push('manager');});sm();
    h+=`<div class="card"><p style="color:var(--mu);font-size:13px;margin-bottom:14px;">Barcha xodimlar va siz ko&#x27;radigan umumiy muhokama</p><div class="cwrap" id="cw2">${grp.length?grp.map(function(m){var snd=m.from==='manager'?null:gE(m.from);return msgBubble(m,m.from==='manager',m.from==='manager'?'Bosh Buxgalter':snd?snd.name:'?',snd);}).join(''):'<p class="echat">Hali xabar yo&#x27;q</p>'}</div><div class="cinp">${chatInputHTML('mgi','btn-mgrp',null)}</div></div>`;
  }
  setHTML('m-ms',h);
  g('m-ms').querySelectorAll('.mtab').forEach(function(btn){btn.onclick=function(){mMT=btn.dataset.mt;if(mMT==='priv')msgTaskRef=null;rMMsgs();};});
  g('m-ms').querySelectorAll('.pi[data-emp]').forEach(function(el){el.onclick=function(){acEmp=el.dataset.emp;rMMsgs();};});
  var ci=g('mci');if(ci)ci.onkeydown=function(e){if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();mSnd();}};
  var bs=g('btn-msnd');if(bs)bs.onclick=mSnd;
  var gi=g('mgi');if(gi)gi.onkeydown=function(e){if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();mGrp();}};
  var bg=g('btn-mgrp');if(bg)bg.onclick=mGrp;
  var ctr=g('btn-clear-task-ref');if(ctr)ctr.onclick=function(){msgTaskRef=null;rMMsgs();};
  scrl('cw1');scrl('cw2');
}
function mSnd(){var i=g('mci');if(!i||!acEmp)return;var c=i.value.trim();if(!c)return;msgs.push({id:uid(),from:'manager',fromName:'Nurmaxamatov Sardor',to:acEmp,content:c,createdAt:new Date().toISOString(),type:'priv',read:['manager'],taskRef:msgTaskRef||null});sm();msgTaskRef=null;rMMsgs();}
function mGrp(){var i=g('mgi');if(!i)return;var c=i.value.trim();if(!c)return;msgs.push({id:uid(),from:'manager',fromName:'Nurmaxamatov Sardor',to:'all',content:c,createdAt:new Date().toISOString(),type:'grp',read:['manager'],taskRef:null});sm();rMMsgs();}

function rEMsgs(){
  if(!U)return;updEMB();
  var pu=msgs.filter(function(m){return m.type==='priv'&&m.to===U.id&&!m.read.includes(U.id);}).length;
  var gu=msgs.filter(function(m){return m.type==='grp'&&!m.read.includes(U.id);}).length;
  var h=`<div class="mtabs"><button class="mtab${eMT==='priv'?' active':''}" data-et="priv">&#x1F512; Bosh Buxgalterga${pu>0?'<span class="undot"></span>':''}</button><button class="mtab${eMT==='grp'?' active':''}" data-et="grp">&#x1F310; Umumiy guruh${gu>0?'<span class="undot"></span>':''}</button></div>`;
  if(eMT==='priv'){
    var ch=msgs.filter(function(m){return m.type==='priv'&&(m.from===U.id||m.to===U.id);});
