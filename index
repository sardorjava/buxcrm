<!DOCTYPE html>
<html lang="uz">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>BuxCRM</title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap" rel="stylesheet"/>
<style>
:root{--bg:#0f0f0f;--sf:#181818;--sf2:#222;--bd:#2a2a2a;--bd2:#333;--tx:#f0ede8;--mu:#888;--ac:#c8f06e;--acd:rgba(200,240,110,.12);--acd2:rgba(200,240,110,.06);--re:#ff5f5f;--red:rgba(255,95,95,.12);--bl:#60a5fa;--bld:rgba(96,165,250,.12);--am:#fbbf24;--amd:rgba(251,191,36,.12);--r:10px;}
*{box-sizing:border-box;margin:0;padding:0;}
body{background:var(--bg);color:var(--tx);font-family:'IBM Plex Sans',sans-serif;min-height:100vh;font-size:14px;}
::-webkit-scrollbar{width:4px;}::-webkit-scrollbar-thumb{background:var(--bd2);border-radius:2px;}
input,select,textarea{width:100%;padding:10px 12px;background:var(--sf2);border:1px solid var(--bd2);border-radius:var(--r);color:var(--tx);font-family:'IBM Plex Sans',sans-serif;font-size:14px;outline:none;transition:border-color .2s;}
input:focus,select:focus,textarea:focus{border-color:var(--ac);}
select option{background:var(--sf2);}
textarea{resize:vertical;line-height:1.7;}
button{cursor:pointer;font-family:'IBM Plex Sans',sans-serif;font-size:14px;border-radius:var(--r);padding:9px 16px;border:1px solid var(--bd2);background:var(--sf2);color:var(--tx);transition:all .15s;}
button:hover{border-color:var(--ac);color:var(--ac);}
button:disabled{opacity:.3;cursor:not-allowed;}
.bp{background:var(--ac);color:#0f0f0f;border-color:var(--ac);font-weight:600;}
.bp:hover{background:#d4f57a;color:#0f0f0f;border-color:#d4f57a;}
.bg{background:transparent;border-color:transparent;color:var(--mu);}
.bg:hover{color:var(--tx);background:var(--sf2);border-color:var(--bd2);}
.bdd{color:var(--re);border-color:transparent;background:transparent;font-size:12px;padding:6px 10px;}
.bdd:hover{background:var(--red);border-color:var(--re);}
.screen{display:none;}.screen.active{display:flex;flex-direction:column;min-height:100vh;}
.hdr{background:var(--sf);border-bottom:1px solid var(--bd);padding:12px 20px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100;}
.logo{display:flex;align-items:center;gap:10px;}
.lmark{width:30px;height:30px;background:var(--ac);border-radius:6px;display:flex;align-items:center;justify-content:center;font-family:'IBM Plex Mono',monospace;font-weight:500;font-size:13px;color:#0f0f0f;}
.ltxt{font-family:'IBM Plex Mono',monospace;font-size:15px;font-weight:500;}
.rpill{padding:3px 10px;border-radius:20px;font-size:12px;font-weight:500;background:var(--acd);color:var(--ac);border:1px solid rgba(200,240,110,.2);}
.tabs{display:flex;overflow-x:auto;border-bottom:1px solid var(--bd);background:var(--sf);padding:0 16px;}
.tab{padding:11px 14px;border:none;background:transparent;color:var(--mu);border-bottom:2px solid transparent;cursor:pointer;white-space:nowrap;font-size:13px;display:flex;align-items:center;gap:5px;transition:color .15s;}
.tab:hover{color:var(--tx);background:transparent;border-color:transparent;}
.tab.active{color:var(--ac);border-bottom-color:var(--ac);}
.tbdg{background:var(--re);color:#fff;border-radius:10px;padding:1px 6px;font-size:10px;font-weight:600;margin-left:2px;}
.main{padding:16px;max-width:680px;margin:0 auto;width:100%;flex:1;}
.card{background:var(--sf);border:1px solid var(--bd);border-radius:var(--r);padding:16px 18px;margin-bottom:10px;}
.cg{border-left:2px solid var(--ac);}.cr{border-left:2px solid var(--re);}
.sgrd{display:grid;grid-template-columns:repeat(auto-fill,minmax(100px,1fr));gap:8px;margin-bottom:20px;}
.sc{background:var(--sf);border:1px solid var(--bd);border-radius:var(--r);padding:14px 12px;text-align:center;}
.sn{font-family:'IBM Plex Mono',monospace;font-size:24px;font-weight:500;margin:6px 0 3px;}
.sl{color:var(--mu);font-size:11px;}
.bdg{display:inline-block;padding:3px 9px;border-radius:20px;font-size:11px;font-weight:500;}
.bpe{background:var(--amd);color:var(--am);border:1px solid rgba(251,191,36,.2);}
.bip{background:var(--bld);color:var(--bl);border:1px solid rgba(96,165,250,.2);}
.bdn{background:var(--acd);color:var(--ac);border:1px solid rgba(200,240,110,.2);}
.bhi{background:var(--red);color:var(--re);border:1px solid rgba(255,95,95,.2);font-size:10px;}
.bme{background:var(--amd);color:var(--am);border:1px solid rgba(251,191,36,.2);font-size:10px;}
.blo{background:var(--acd);color:var(--ac);border:1px solid rgba(200,240,110,.2);font-size:10px;}
.av{border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:600;flex-shrink:0;font-family:'IBM Plex Mono',monospace;}
.lwrap{display:flex;align-items:center;justify-content:center;min-height:100vh;padding:20px;}
.lcard{background:var(--sf);border:1px solid var(--bd);border-radius:16px;padding:36px 32px;width:100%;max-width:380px;}
.llgo{width:56px;height:56px;background:var(--ac);border-radius:12px;display:flex;align-items:center;justify-content:center;font-family:'IBM Plex Mono',monospace;font-weight:500;font-size:20px;color:#0f0f0f;margin:0 auto 16px;}
.rbtn{display:flex;align-items:center;gap:14px;background:var(--sf2);border:1px solid var(--bd2);border-radius:var(--r);padding:14px 16px;cursor:pointer;text-align:left;width:100%;margin-bottom:10px;transition:all .15s;color:var(--tx);}
.rbtn:hover{border-color:var(--ac);background:var(--acd2);}
.fl{display:block;font-size:12px;color:var(--mu);margin-bottom:6px;letter-spacing:.5px;font-family:'IBM Plex Mono',monospace;}
.fg{margin-bottom:12px;}
.err{color:var(--re);font-size:12px;margin-top:4px;display:none;}
.brow{display:flex;gap:8px;margin-top:14px;}
.empty{text-align:center;padding:50px 20px;}
.stf{display:flex;gap:6px;margin-bottom:14px;flex-wrap:wrap;}
.stb{padding:6px 12px;font-size:12px;font-family:'IBM Plex Mono',monospace;}
.stb.active{background:var(--ac);color:#0f0f0f;border-color:var(--ac);}
.sec{font-size:12px;font-weight:500;color:var(--mu);letter-spacing:.8px;margin-bottom:12px;font-family:'IBM Plex Mono',monospace;text-transform:uppercase;}
.smsg{background:var(--acd);border:1px solid rgba(200,240,110,.2);border-radius:var(--r);padding:12px 16px;color:var(--ac);margin-bottom:14px;display:flex;align-items:center;gap:8px;font-weight:500;}
.trep{background:var(--sf2);border:1px solid rgba(200,240,110,.2);border-radius:var(--r);padding:14px;margin-bottom:16px;}
.frow{display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap;}
.frow input,.frow select{flex:1;min-width:120px;}
.tact{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;margin-top:12px;}
.tmta{display:flex;gap:10px;flex-wrap:wrap;align-items:center;}
.tmta span{color:var(--mu);font-size:12px;font-family:'IBM Plex Mono',monospace;}
.od{color:var(--re)!important;}
.dn{background:var(--sf2);border-radius:6px;padding:10px;margin-top:8px;font-size:13px;color:var(--mu);font-style:italic;}
.pw{background:var(--bg);border-radius:4px;height:4px;overflow:hidden;margin-top:8px;}
.pb{background:var(--ac);height:100%;border-radius:4px;transition:width .4s;}
.mov{position:fixed;inset:0;background:rgba(0,0,0,.75);display:flex;align-items:center;justify-content:center;z-index:200;padding:20px;}
.modal{background:var(--sf);border:1px solid var(--bd2);border-radius:16px;padding:24px;width:100%;max-width:420px;max-height:90vh;overflow-y:auto;}
.fdrop{border:1px dashed var(--bd2);border-radius:var(--r);padding:11px 14px;display:flex;align-items:center;gap:8px;cursor:pointer;color:var(--mu);font-size:13px;transition:all .2s;background:var(--sf2);}
.fdrop:hover,.fdrop.hf{border-color:var(--ac);color:var(--ac);}
.fattch{display:inline-flex;align-items:center;gap:6px;background:var(--sf2);border:1px solid var(--bd2);border-radius:6px;padding:6px 10px;color:var(--ac);text-decoration:none;font-size:12px;font-family:'IBM Plex Mono',monospace;margin-top:8px;word-break:break-all;}
.task-ref{background:var(--acd2);border:1px solid rgba(200,240,110,.15);border-radius:6px;padding:6px 10px;font-size:12px;color:var(--ac);margin-bottom:8px;display:flex;align-items:center;gap:6px;}
.cwrap{display:flex;flex-direction:column;max-height:320px;overflow-y:auto;padding:4px 0;margin-bottom:12px;}
.cmsg{display:flex;gap:10px;margin-bottom:12px;align-items:flex-end;}
.cmsg.mine{flex-direction:row-reverse;}
.cbbl{max-width:78%;padding:10px 14px;border-radius:14px;font-size:14px;line-height:1.6;white-space:pre-wrap;word-break:break-word;}
.cbbl.oth{background:var(--sf2);border:1px solid var(--bd2);border-bottom-left-radius:4px;}
.cbbl.mn{background:var(--acd);border:1px solid rgba(200,240,110,.2);border-bottom-right-radius:4px;}
.ctim{font-size:11px;color:var(--mu);font-family:'IBM Plex Mono',monospace;margin-top:3px;display:block;}
.cnm{font-size:12px;color:var(--mu);font-family:'IBM Plex Mono',monospace;margin-bottom:3px;}
.msg-task-tag{background:var(--acd2);border:1px solid rgba(200,240,110,.2);border-radius:4px;padding:2px 7px;font-size:11px;color:var(--ac);display:block;margin-bottom:5px;}
.cinp{display:flex;flex-direction:column;gap:8px;}
.cinp-row{display:flex;gap:8px;align-items:flex-end;}
.cinp-row textarea{min-height:44px;max-height:100px;resize:none;flex:1;}
.mtabs{display:flex;gap:6px;margin-bottom:16px;flex-wrap:wrap;}
.mtab{padding:7px 14px;font-size:13px;border-radius:20px;}
.mtab.active{background:var(--ac);color:#0f0f0f;border-color:var(--ac);font-weight:600;}
.undot{display:inline-block;width:7px;height:7px;background:var(--re);border-radius:50%;margin-left:4px;vertical-align:middle;}
.plist .pi{display:flex;gap:12px;align-items:center;padding:12px 14px;border-radius:var(--r);cursor:pointer;transition:background .15s;margin-bottom:4px;}
.plist .pi:hover{background:var(--sf2);}
.plist .pi.acp{background:var(--acd2);border:1px solid rgba(200,240,110,.15);}
.echat{text-align:center;padding:30px 20px;color:var(--mu);font-size:13px;}
.npinfo{background:var(--acd2);border:1px solid rgba(200,240,110,.15);border-radius:var(--r);padding:10px 12px;margin-bottom:10px;}
.link-card{background:var(--sf2);border:1px solid var(--bd2);border-radius:var(--r);padding:10px 14px;margin-bottom:8px;display:flex;align-items:center;justify-content:space-between;gap:10px;}
.link-url{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--mu);word-break:break-all;flex:1;}
@media(max-width:480px){.lcard{padding:24px 18px;}.main{padding:12px;}}
</style>
</head>
<body>
<div id="s-login" class="screen active">
  <div class="lwrap"><div class="lcard">
    <div style="text-align:center;margin-bottom:28px;">
      <div class="llgo">BX</div>
      <div style="font-size:22px;font-weight:600;margin-bottom:4px;">BuxCRM</div>
      <div style="color:var(--mu);font-size:13px;">Buxgalteriya boshqaruv tizimi</div>
    </div>
    <div id="lsel">
      <button class="rbtn" id="btn-mgr"><span style="font-size:20px;">&#x1F6E1;</span><div><div style="font-size:14px;font-weight:500;">Bosh Buxgalter</div><div style="font-size:12px;color:var(--mu);">Nurmaxamatov Sardor</div></div></button>
      <div id="emp-btns"></div>
    </div>
    <div id="lmgr" style="display:none">
      <div class="fg"><label class="fl">PIN KOD</label><input type="password" id="mpn" placeholder="&#8226;&#8226;&#8226;&#8226;"/><div id="mpe" class="err">&#x274C; Noto&#x2018;g&#x2018;ri PIN</div></div>
      <div class="brow"><button class="bg" id="btn-back-mgr">&#8592; Orqaga</button><button class="bp" id="btn-mlogin" style="flex:2">Kirish</button></div>
    </div>
    <div id="lemp" style="display:none">
      <div id="emp-name-show" style="font-weight:500;font-size:16px;text-align:center;margin-bottom:14px;"></div>
      <div id="epb"><div class="fg"><label class="fl">PIN KOD</label><input type="password" id="epin" placeholder="&#8226;&#8226;&#8226;&#8226;" maxlength="6"/><div id="epe" class="err">&#x274C; Noto&#x2018;g&#x2018;ri PIN</div></div></div>
      <div id="enb" style="display:none">
        <div class="npinfo"><p style="color:var(--ac);font-size:12px;">&#x1F510; Birinchi kirish &#8212; PIN o&#x2018;rnating</p></div>
        <div class="fg"><label class="fl">YANGI PIN (4-6 raqam)</label><input type="password" id="np1" placeholder="&#8226;&#8226;&#8226;&#8226;" maxlength="6"/></div>
        <div class="fg"><label class="fl">TASDIQLASH</label><input type="password" id="np2" placeholder="&#8226;&#8226;&#8226;&#8226;" maxlength="6"/><div id="npe" class="err">&#x274C; PIN kodlar mos kelmadi</div></div>
      </div>
      <div class="brow"><button class="bg" id="btn-back-emp">&#8592; Orqaga</button><button class="bp" id="btn-elogin" style="flex:2">Kirish</button></div>
    </div>
  </div></div>
</div>

<div id="s-mgr" class="screen">
  <div class="hdr"><div class="logo"><div class="lmark">BX</div><span class="ltxt">BuxCRM</span><span class="rpill">Bosh Buxgalter</span></div><button class="bg" id="btn-mlogout" style="padding:6px 12px;font-size:13px;">Chiqish</button></div>
  <div class="tabs" id="mt">
    <button class="tab active" data-tab="da">&#x1F4CB; Asosiy</button>
    <button class="tab" data-tab="re">&#x1F4C4; Hisobotlar</button>
    <button class="tab" data-tab="ta">&#x2705; Vazifalar</button>
    <button class="tab" data-tab="ms">&#x1F4AC; Xabarlar <span class="tbdg" id="mb-m" style="display:none">0</span></button>
    <button class="tab" data-tab="em">&#x1F465; Xodimlar</button>
  </div>
  <div class="main"><div id="m-da"></div><div id="m-re" style="display:none"></div><div id="m-ta" style="display:none"></div><div id="m-ms" style="display:none"></div><div id="m-em" style="display:none"></div></div>
</div>

<div id="s-emp" class="screen">
  <div class="hdr"><div class="logo"><div class="lmark">BX</div><span class="ltxt">BuxCRM</span><span class="rpill" id="erp">Xodim</span></div><button class="bg" id="btn-elogout" style="padding:6px 12px;font-size:13px;">Chiqish</button></div>
  <div class="tabs" id="et">
    <button class="tab active" data-tab="ta">&#x2705; Vazifalarim <span class="tbdg" id="etb" style="display:none">0</span></button>
    <button class="tab" data-tab="re">&#x1F4DD; Hisobot</button>
    <button class="tab" data-tab="ms">&#x1F4AC; Xabarlar <span class="tbdg" id="mb-e" style="display:none">0</span></button>
  </div>
  <div class="main"><div id="e-ta"></div><div id="e-re" style="display:none"></div><div id="e-ms" style="display:none"></div></div>
</div>

<!-- Done Modal -->
<div class="mov" id="dmod" style="display:none">
  <div class="modal">
    <h3 style="font-weight:500;margin-bottom:4px;">Vazifa bajarildi &#x2713;</h3>
    <p style="color:var(--mu);font-size:13px;margin-bottom:14px;">Izoh va fayl (ixtiyoriy)</p>
    <div class="fg"><textarea id="dnt" style="min-height:80px;" placeholder="Bajarilganini qisqacha yozing..."></textarea></div>
    <div class="fg">
      <label class="fl">FAYL BIRIKTIRISH</label>
      <div class="fdrop" id="dfd"><span>&#x1F4CE;</span><span id="dfl">Fayl tanlash (max 5MB)</span><input type="file" id="dfi" style="display:none"/></div>
    </div>
    <div class="brow"><button id="btn-close-dm">Bekor</button><button class="bp" id="btn-confirm-dm" style="flex:1">Tasdiqlash</button></div>
  </div>
</div>

<script>
'use strict';
var EMP = [
  {id:'e1',name:'Mamatov Inomjon',   av:'MI',c:['#3730a3','#c7d2fe']},
  {id:'e2',name:'Raxmanov Kamoliddin', av:'RK',c:['#065f46','#a7f3d0']},
  {id:'e3',name:'Xabiybullayev Jamoliddin',av:'XJ',c:['#78350f','#fde68a']},
  {id:'e4',name:'Valiyeva Gulbaxor',  av:'VG',c:['#1e3a5f','#bfdbfe']},
  {id:'e5',name:'Usmonxojayeva Gulnora',av:'UG',c:['#831843','#fbcfe8']},
  {id:'e6',name:'Tuxtayev Ilhom',    av:'TI',c:['#3a5a00','#d9f99d']}
];
function lsGet(k,d){try{var v=localStorage.getItem(k);return v?JSON.parse(v):d;}catch(e){return d;}}
function lsSet(k,v){try{localStorage.setItem(k,JSON.stringify(v));}catch(e){}}
var reps  = lsGet('bx_r',[]);
var tasks = lsGet('bx_t',[]);
var pins  = lsGet('bx_p',{});
var msgs  = lsGet('bx_m',[]);
function sv(){lsSet('bx_r',reps);lsSet('bx_t',tasks);}
function sp(){lsSet('bx_p',pins);}
function sm(){lsSet('bx_m',msgs);}

var U=null, doneId=null, doneFile=null, taskFile=null, showTF=false;
var tf={ti:'',ds:'',em:'',du:'',pr:'medium'};
var repOk=false, mrEF='all', mrDF='', tFlt='all', acEmp=null, mMT='priv', eMT='priv';
var selEmpId=null;
var msgTaskRef=null; // {id, title} - task reference for messaging

function uid(){return Date.now().toString(36)+Math.random().toString(36).slice(2,5);}
function tday(){return new Date().toISOString().split('T')[0];}
function fd(d){if(!d)return'';try{return new Date(d).toLocaleDateString('uz-UZ');}catch(e){return d;}}
function ft(d){if(!d)return'';try{return new Date(d).toLocaleTimeString('uz-UZ',{hour:'2-digit',minute:'2-digit'});}catch(e){return'';}}
function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function isOD(due){if(!due)return false;return new Date(due)<new Date(tday());}
function gE(id){return EMP.find(function(e){return e.id===id;});}
function scrl(id){setTimeout(function(){var el=document.getElementById(id);if(el)el.scrollTop=el.scrollHeight;},80);}
function showS(id){document.querySelectorAll('.screen').forEach(function(s){s.classList.remove('active');});document.getElementById(id).classList.add('active');}
function g(id){return document.getElementById(id);}
function hide(id){var el=g(id);if(el)el.style.display='none';}
function show(id,d){var el=g(id);if(el)el.style.display=d||'block';}
function setHTML(id,h){var el=g(id);if(el)el.innerHTML=h;}

function avH(e,sz){
  sz=sz||36;
  if(!e)return `<div class="av" style="width:${sz}px;height:${sz}px;background:#333;font-size:${Math.round(sz*.35)}px;color:#888;">?</div>`;
  return `<div class="av" style="width:${sz}px;height:${sz}px;background:${e.c[1]}25;color:${e.c[1]};font-size:${Math.round(sz*.33)}px;border:1px solid ${e.c[1]}40;">${e.av}</div>`;
}
function bdg(s){
  var l={pending:'Kutilmoqda',in_progress:'Jarayonda',done:'Bajarildi'};
  var cl={pending:'bpe',in_progress:'bip',done:'bdn'};
  return `<span class="bdg ${cl[s]||'bpe'}">${l[s]||s}</span>`;
}
function pBdg(p){
  var l={high:'Muhim',medium:"O'rta",low:'Oddiy'};
  var cl={high:'bhi',medium:'bme',low:'blo'};
  var ic={high:'&#128308;',medium:'&#128993;',low:'&#128994;'};
  return p?`<span class="bdg ${cl[p]||'bme'}">${ic[p]||''} ${l[p]||p}</span>`:'';
}
function fAttach(f){
  if(!f)return'';
  var ext=(f.name.split('.').pop()||'').toUpperCase();
  var ic={PDF:'&#x1F4C4;',DOC:'&#x1F4DD;',DOCX:'&#x1F4DD;',XLS:'&#x1F4CA;',XLSX:'&#x1F4CA;',JPG:'&#x1F5BC;',JPEG:'&#x1F5BC;',PNG:'&#x1F5BC;',ZIP:'&#x1F5DC;'}[ext]||'&#x1F4CE;';
  var kb=f.size<1024?f.size+'B':f.size<1048576?Math.round(f.size/1024)+'KB':(f.size/1048576).toFixed(1)+'MB';
  return `<a href="${f.data}" download="${esc(f.name)}" class="fattch">${ic} ${esc(f.name)} <span style="color:var(--mu);">(${kb})</span></a>`;
}
function readFile(file){return new Promise(function(res,rej){var r=new FileReader();r.onload=function(e){res(e.target.result);};r.onerror=rej;r.readAsDataURL(file);});}
function updMMB(){var n=msgs.filter(function(m){return m.type==='priv'&&!m.read.includes('manager');}).length;var b=g('mb-m');if(b){b.textContent=n;b.style.display=n>0?'inline':'none';}}
function updEMB(){if(!U)return;var n=msgs.filter(function(m){return(m.type==='priv'&&m.to===U.id||m.type==='grp')&&!m.read.includes(U.id);}).length;var b=g('mb-e');if(b){b.textContent=n;b.style.display=n>0?'inline':'none';}}
